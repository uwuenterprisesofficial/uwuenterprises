{
  "name": "uwu-enterprises",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c magenta,cyan \"vite\" \"npm:dev:server\"",
    "build": "tsc -b && vite build && tsc -p server",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p server --noEmit",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "docker:build": "docker compose build",
    "docker:push": "docker compose build && docker compose push",
    "dev:server": "tsx watch server/index.ts",
    "start": "node server/dist/index.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/multipart": "^10.1.3",
    "@fastify/static": "^10.1.6",
    "fastify": "^5.12.7",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^10.0.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "three": "^0.186.1",
    "tsx": "^4.23.15",
    "typescript": "^5.5.3",
    "vite": "^5.4.2"
  }
}
